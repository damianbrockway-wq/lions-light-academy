# Force the FILLABLE PDFs to download instead of opening in the browser's
# inline viewer. Required because Safari (Mac and iOS) often ignores the
# HTML `download` attribute for PDFs and traps users in a preview with no
# controls — no Download, no Print, no Back.
#
# Read-only PDFs (Code of Conduct, Parent Packet, Safety Plan, etc.) are
# intentionally NOT in this list — they should preview naturally in-browser
# so visitors can just read them. Anyone who wants to save those can use
# the browser's built-in PDF Save / Share menu.

/docs/registration-enrollment.pdf
  Content-Disposition: attachment; filename="LLA-Registration-2026-2027.pdf"

/docs/supply-fee-receipt.pdf
  Content-Disposition: attachment; filename="LLA-Supply-Fee-Receipt.pdf"

/docs/field-trip-waiver.pdf
  Content-Disposition: attachment; filename="LLA-Field-Trip-Waiver.pdf"

/docs/hs-credit-summary.pdf
  Content-Disposition: attachment; filename="LLA-HS-Credit-Summary.pdf"

/docs/maine-homeschool-checklist.pdf
  Content-Disposition: attachment; filename="LLA-Maine-Homeschool-Checklist.pdf"

# ── Internal kit ────────────────────────────────────────────────────────────
# /kit/ holds printable masters and templates. Nothing on the site links to it.
# Cloudflare Pages serves every file in this repo whether or not it is linked,
# so this is UNLISTED, NOT PRIVATE — the header below only keeps it out of
# search results. Anyone who has the address can still open it. For a real
# gate, put a Cloudflare Access policy on /kit/* in the dashboard.

/kit/*
  X-Robots-Tag: noindex, nofollow, noarchive

# ── Document sources and build pipeline ─────────────────────────────────────
# These are in the repo so the documents can always be rebuilt and so git keeps
# their history. They are published like everything else here — the content is
# already public as PDFs — but there is no reason for them to be indexed.
#
# teacher_id.html is deliberately NOT in this repo: it embeds photographs of
# real teachers. It lives only in the local build kit tarball.

/sources/*
  X-Robots-Tag: noindex, nofollow

/pipeline/*
  X-Robots-Tag: noindex, nofollow
